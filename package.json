{
  "name": "orb.js",
  "version": "3.0.0",
  "description": "JavaScript library for astronomical calculations",
  "main": "dist/orb.js",
  "files": [
    "dist",
    "src",
    "readme.md",
    "usage.en.md",
    "usage.ja.md",
    "MIT-LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.js && node test/v4/run.mjs && node test/v4/kepler.mjs && node test/v4/bodies.mjs && node test/v4/observer.mjs && node test/v4/horizons-ref.mjs && node test/v4/satellite-events.mjs && node test/v4/compat.mjs && node test/v4/sky.mjs",
    "bench": "node tools/bench.mjs",
    "catalog:compile": "node tools/catalog-compile.js",
    "build": "rollup -c rollup.config.js",
    "edu:snippets": "node tools/snippets.js",
    "edu:check": "node tools/snippets.js --check",
    "edu:annotate": "node tools/annotate.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizard-isana/orb.js.git"
  },
  "author": "Isana Kashiwai",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lizard-isana/orb.js/issues"
  },
  "homepage": "https://github.com/lizard-isana/orb.js",
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@babel/preset-env": "^7.16.11",
    "@rollup/plugin-babel": "^5.3.1",
    "rollup": "^2.79.1",
    "rollup-plugin-terser": "^7.0.2"
  }
}
