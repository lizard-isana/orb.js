{
  "name": "@lizard-isana/orb",
  "version": "3.0.0",
  "description": "JavaScript library for astronomical calculations",
  "main": "dist/orb.js",
  "files": [
    "dist",
    "src/*.js",
    "src/time",
    "src/frames",
    "src/geodesy",
    "src/kepler",
    "src/events",
    "src/models/earth-epv00",
    "src/observer",
    "src/vocab",
    "src/vsop87a",
    "readme.md",
    "usage.en.md",
    "usage.ja.md",
    "MIT-LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/orb.esm.mjs",
      "default": "./dist/orb.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./time": {
      "import": "./src/time/index.js"
    },
    "./frames": {
      "import": "./src/frames/index.js"
    },
    "./geodesy": {
      "import": "./src/geodesy/index.js"
    },
    "./kepler": {
      "import": "./src/kepler/index.js"
    },
    "./events": {
      "import": "./src/events/index.js"
    },
    "./models/earth-epv00": {
      "import": "./src/models/earth-epv00/index.js"
    },
    "./observer": {
      "import": "./src/observer/index.js"
    },
    "./vocab": {
      "import": "./src/vocab/index.js"
    },
    "./vsop87a/*.js": "./src/vsop87a/*.js",
    "./vsop87a/*": "./src/vsop87a/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/run.js && node test/m1/core.mjs && node test/m2/core.mjs && node test/m3/core.mjs && node test/m4/core.mjs",
    "build": "rollup -c rollup.config.js",
    "bench": "node tools/bench.mjs",
    "vsop:check": "node tools/vsop-compile.mjs --check",
    "vsop:write": "node tools/vsop-compile.mjs --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizard-isana/orb.js.git"
  },
  "author": "Isana Kashiwai",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lizard-isana/orb.js/issues"
  },
  "homepage": "https://github.com/lizard-isana/orb.js",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@babel/preset-env": "^7.16.11",
    "@rollup/plugin-babel": "^5.3.1",
    "rollup": "^2.79.1",
    "rollup-plugin-terser": "^7.0.2"
  }
}
